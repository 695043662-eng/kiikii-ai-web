# ============================================================
# Kiikii AI 环境变量模板
# 使用方法：cp .env.example .env.local，然后填入真实值
# 安全规则：.env.local 已在 .gitignore 中，绝不能提交到 Git
# ============================================================

# ==================== 核心框架 ====================

# Next.js 环境标识（development / production / test）
# 自动注入，一般不需要手动设置
NODE_ENV=

# ==================== 站点配置 ====================

# 站点公开 URL（用于 Webhook 回调、分享链接等）
NEXT_PUBLIC_SITE_URL=

# 沙盒环境域名（沙盒自动注入，本地开发不需要）
COZE_PROJECT_DOMAIN_DEFAULT=

# Vercel 部署域名（Vercel 自动注入）
VERCEL_URL=

# ==================== 数据库（Supabase）====================

# Supabase 项目 URL（必填）
SUPABASE_URL=

# Supabase 匿名密钥（前端客户端使用，必填）
SUPABASE_ANON_KEY=

# Supabase 服务端管理员密钥（后端 API 使用，绕过 RLS，必填⚠️）
# ⚠️ 绝对不能泄露！拥有此密钥等同于拥有数据库完全控制权
SUPABASE_SERVICE_ROLE_KEY=

# 前端 Supabase URL（如与后端不同时使用，通常留空即可）
NEXT_PUBLIC_SUPABASE_URL=

# ==================== 认证安全 ====================

# JWT 签名密钥（必填⚠️）
# 用于签发和验证用户登录 Token，防止 Cookie 伪造
# 建议使用：openssl rand -hex 32 生成
AUTH_JWT_SECRET=

# 密码哈希盐值（必填⚠️）
# 用于 SHA-256 密码哈希，迁移到 bcrypt 后此值可废弃
# ⚠️ 修改此值会导致所有旧密码无法验证
PASSWORD_SALT=

# 管理员手机号（必填）
# 管理后台权限判断依据，不再硬编码在代码中
ADMIN_PHONE=

# 管理员手机号（前端使用，构建时内联）
NEXT_PUBLIC_ADMIN_PHONE=

# 用户默认头像 URL（可选）
# 新注册用户的默认头像，留空使用 Gravatar 风格占位图
NEXT_PUBLIC_DEFAULT_AVATAR_URL=

# ==================== AI 服务商 ====================

# GRS 生图网关 API 端点（可选）
GRS_API_ENDPOINT=

# GRS API 密钥（可选，部分模型需要）
GRS_API_KEY=

# 前端 API 端点（管理后台测试中心使用）
NEXT_PUBLIC_API_ENDPOINT=

# 前端默认 API 密钥（管理后台测试中心使用）
NEXT_PUBLIC_DEFAULT_API_KEY=

# 供应商积分查询 API URL（必填）
# 用于查询用户在供应商平台的积分余额
SUPPLIER_API_URL=

# 供应商积分查询 API Token（必填⚠️）
# ⚠️ 绝对不能泄露！泄露后攻击者可操纵积分
SUPPLIER_API_TOKEN=

# 视频生成 API 端点（可选）
VIDEO_API_ENDPOINT=

# 视频生成 API 密钥（可选）
VIDEO_API_KEY=

# Webhook 回调基础 URL（可选）
# AI 服务商完成生成后的回调地址，默认使用 SITE_URL
WEBHOOK_BASE_URL=

# Webhook HMAC 签名密钥（必填⚠️）
# 用于验证回调请求的真实性，防止伪造
# 建议使用：openssl rand -hex 32 生成
WEBHOOK_HMAC_SECRET=

# ==================== 对象存储（腾讯云 COS 双桶架构）====================

# 共享密钥（两个桶使用同一对 AK/SK）
COS_SECRET_ID=
COS_SECRET_KEY=

# 1号桶（Temp）：AI 生成临时素材，5天生命周期
COS_BUCKET_TEMP=
COS_REGION_TEMP=ap-hongkong
COS_DOMAIN_TEMP=

# 2号桶（Perm）：VIP 资产与系统固定资产，永久存储
COS_BUCKET_PERM=
COS_REGION_PERM=ap-hongkong
COS_DOMAIN_PERM=

# CDN 域名（用于1号桶图片/视频访问）
COS_CDN_DOMAIN=

# 2号桶 CDN 域名（perm 静态资产专用，运维配置后生效）
# 前置条件：1. 腾讯云控制台给2号桶绑定此域名  2. 2号桶 ACL 改为 public-read  3. Cloudflare 添加 DNS 解析
COS_CDN_DOMAIN_PERM=

# 前端可访问的2号桶 CDN 域名（AssetCard 等组件使用）
NEXT_PUBLIC_COS_CDN_DOMAIN_PERM=

# 向后兼容（旧代码仍可使用，指向1号桶）
COS_BUCKET=
COS_REGION=
COS_DOMAIN=

# ==================== 邮件服务（腾讯云 SES）====================

# 腾讯云 SecretId（可选，邮件功能需要）
TENCENTCLOUD_SECRET_ID=

# 腾讯云 SecretKey（可选，邮件功能需要）
TENCENTCLOUD_SECRET_KEY=

# 腾讯云区域（默认：ap-guangzhou）
TENCENTCLOUD_REGION=

# 发件人邮箱地址（默认：noreply@mail.kiikii.me）
SES_SENDER_EMAIL=

# 发件人名称（默认：Kiikii AI）
SES_SENDER_NAME=

# ==================== 支付（支付宝）====================

# 支付宝合作者身份 ID（可选，支付功能需要）
PAYMENT_PID=

# 支付宝密钥（可选，支付功能需要）
PAYMENT_KEY=

# 支付宝网关 URL（可选）
PAYMENT_API_URL=

# 充值记录后端 API 基础 URL（可选）
NEXT_PUBLIC_API_BASE_URL=

# 充值记录查询 Token（可选）
BACKEND_API_TOKEN=

# ==================== 频率限制 ====================

# IP 频率限制 - 每小时最大请求数（默认：5）
RATE_LIMIT_HOURLY=

# IP 频率限制 - 每天最大请求数（默认：10）
RATE_LIMIT_DAILY=

# ==================== 前端静态资源 ====================

# 智能分割参考图 URL（默认：/grid-original.png）
NEXT_PUBLIC_GRID_ORIGINAL_URL=
