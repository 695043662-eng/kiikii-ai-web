# ===========================================
# 🔒 Kiikii 生产环境配置模板
# 📍 目标服务器：香港 VPS (2核2G)
# ===========================================
# 
# ⚠️ 使用说明：
# 1. 复制此文件为 .env.production
# 2. 填写所有必填项（标记为 [必填]）
# 3. 将 localhost 替换为真实域名
# 4. 确保敏感信息不泄露
#
# 📦 部署时需要替换的关键变量：
#    - localhost:5000 → https://kiikii.me
#    - 所有 API Key 和密钥需要生产环境的真实值
# ===========================================

# ===========================================
# 🌍 基础环境配置
# ===========================================
NODE_ENV=production
TZ=Asia/Shanghai                    # 或 Asia/Hong_Kong
PORT=5000
HOSTNAME=0.0.0.0

# ===========================================
# 🌐 生产域名配置 [必填]
# ===========================================
# ⚠️ 替换为真实的生产域名
NEXT_PUBLIC_SITE_URL=https://kiikii.me

# ===========================================
# 🗄️ Supabase 数据库配置 [必填]
# ===========================================
# ⚠️ 使用生产环境的 Supabase 项目配置
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# 🤖 GRS AI 生图 API 配置 [必填]
# ===========================================
GRS_API_ENDPOINT=https://grsai.dakka.com.cn
GRS_API_KEY=your-grs-api-key

# 通用 API 配置（前端使用）
NEXT_PUBLIC_API_ENDPOINT=https://grsai.dakka.com.cn
NEXT_PUBLIC_DEFAULT_API_KEY=your-api-key

# ===========================================
# 📦 腾讯云 COS 存储配置 [必填]
# ===========================================
COS_SECRET_ID=your-secret-id
COS_SECRET_KEY=your-secret-key
COS_BUCKET=your-bucket-name
COS_REGION=ap-hongkong
COS_DOMAIN=https://your-bucket.cos.ap-hongkong.myqcloud.com

# ===========================================
# 📧 腾讯云邮件服务配置 [可选]
# ===========================================
TENCENTCLOUD_SECRET_ID=your-secret-id
TENCENTCLOUD_SECRET_KEY=your-secret-key
TENCENTCLOUD_REGION=ap-hongkong
SES_SENDER_EMAIL=noreply@mail.kiikii.me
SES_SENDER_NAME=Kiikii AI

# ===========================================
# 🛡️ IP 频率限制配置 [可选]
# ===========================================
# 防止验证码接口被恶意刷取
# 单个 IP 1 小时内最多发送验证码次数
RATE_LIMIT_HOURLY=5
# 单个 IP 24 小时内最多发送验证码次数
RATE_LIMIT_DAILY=10

# ===========================================
# 🔗 Webhook 回调配置
# ===========================================
# AI 生成完成后的回调地址
# ⚠️ 替换 localhost:5000 为生产域名
WEBHOOK_BASE_URL=https://kiikii.me

# ===========================================
# 📝 注意事项
# ===========================================
# 1. 所有 localhost:5000 都需要替换为 https://kiikii.me
# 2. API Key 不能使用开发环境的值
# 3. 数据库连接使用生产环境的 Supabase 项目
# 4. COS 存储桶建议使用香港区域
# 5. 确保防火墙开放 5000 端口（或使用 Nginx 反向代理 80/443）
